# Firebase Admin SDK — service account JSON as a single-line string
# Generate at: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Then: cat serviceAccountKey.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Server
PORT=3000

# Cron endpoints protection — set a strong random string
CRON_SECRET=change-me-to-a-random-secret
